# Session-signing secret for the auth proxy — regenerated on first run
.secret

# Runtime logs
*.log
*.log.err
*.err
*.out
wire.log
search.log
autostart.log

# Harness runtime state (conversations, storages, credentials)
sessions/
storages/
profiles/*/node_modules/

# cloudflared tunnel credentials — never commit
*.json
!package.json

# Backups
*.bak
*.bak2
*.bak-*
__pycache__/
*.pyc
dsh/plugins/browser-viewer/lib/work-buddy-plush-v1.png
dsh/plugins/browser-viewer/lib/work-buddy-plush-before-face.png
dsh/plugins/browser-viewer/lib/work-buddy-fur.png

# Generated by install.ps1 - machine-specific paths
seek.config.ps1
