{
  "name": "seek-desktop-bridge",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.mjs",
    "build:native": "node scripts/native.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:turn": "node scripts/turn-smoke.mjs",
    "smoke:packaged": "node scripts/smoke.mjs --packaged",
    "build:dir": "node scripts/build.mjs --dir",
    "build": "node scripts/build.mjs",
    "test:python": "python -m unittest discover -s test -p test_*.py",
    "smoke:input": "node scripts/smoke.mjs --input",
    "smoke:packaged:input": "node scripts/smoke.mjs --packaged --input",
    "package": "node scripts/package.mjs",
    "verify:mac": "node scripts/verify-mac.mjs"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "description": "Seek desktop control companion",
  "author": "Joel Robinson",
  "license": "UNLICENSED",
